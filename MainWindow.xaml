<Window x:Class="ObysidianDS4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ativação de Licença — Obysidian DS4" 
        Height="400" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0A0B10"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎮" FontSize="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="OBYSIDIAN DS4" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Border Background="#2B171A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SISTEMA DE LICENÇA" FontSize="10" FontWeight="Bold" Foreground="#EF4444"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Insira sua chave de ativação para desbloquear o emulador de controle e macros." 
                       FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- HWID da Máquina -->
        <Border Grid.Row="1" Background="#13141F" BorderBrush="#222538" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IDENTIFICADOR ÚNICO DO SEU PC (HWID):" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                    <TextBlock x:Name="TxtHwid" Text="Carregando HWID..." FontSize="13" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="📋 Copiar HWID" Background="#1D2032" Foreground="#D1D5DB" 
                        BorderBrush="#2F344F" BorderThickness="1" Padding="10,6" Cursor="Hand"
                        Click="BtnCopiarHwid_Click"/>
            </Grid>
        </Border>

        <!-- Campo de Digitação da Chave -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <TextBlock Text="CHAVE DE LICENÇA DO DS4 (KEY):" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtChave" 
                     Height="42" 
                     Background="#141622" 
                     Foreground="#FFFFFF" 
                     CaretBrush="#EF4444"
                     BorderBrush="#DC2626" 
                     BorderThickness="1.5" 
                     Padding="10,9" 
                     FontSize="15" 
                     FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtStatus" Text="" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Botão de Ativação -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Suporte &amp; Vendas: Discord Oficial" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="🔓 Ativar e Iniciar DS4" 
                    Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                    Padding="22,10" BorderThickness="0" Cursor="Hand"
                    Click="BtnAtivar_Click"/>
        </Grid>
    </Grid>
</Window>
